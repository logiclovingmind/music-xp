<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd job: runs the daily builder at 07:00 every day.
     Install:
       cp com.zei.musicxp.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.zei.musicxp.plist
     Edit the two paths below to match where this project lives. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zei.musicxp</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/zei/Downloads/zEiXP/Music XP/run_daily.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/zei/Downloads/zEiXP/Music XP</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/zei/Downloads/zEiXP/Music XP/data/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/zei/Downloads/zEiXP/Music XP/data/launchd.err.log</string>
</dict>
</plist>
