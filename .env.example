# Copy to .env and fill in. All are optional except where noted.

# Spotify (free dev app) — used for daily new-releases + artist genres.
# Create at https://developer.spotify.com/dashboard (Client Credentials flow, no redirect needed).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm (free API key) — used to expand your taste into similar artists + genre tags.
# Create at https://www.last.fm/api/account/create
LASTFM_API_KEY=
